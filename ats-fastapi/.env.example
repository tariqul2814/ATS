# Copy to .env and adjust. Only APP_WEBHOOK__SECRET is required.

# Shared HMAC secret — must equal the orchestrator's Webhook:Secret. Never commit a real value.
APP_WEBHOOK__SECRET=change-me

# Ollama
APP_OLLAMA__BASE_URL=http://localhost:11434
APP_OLLAMA__MODEL=qwen2.5:3b
APP_OLLAMA__TEMPERATURE=0.2
APP_OLLAMA__NUM_CTX=16384

# LLM execution. Defaults suit a CPU-only host; with a GPU, lower the timeout and raise concurrency.
APP_LLM__TIMEOUT_SECONDS=480
APP_LLM__MAX_CONCURRENCY=1
APP_LLM__MAX_IN_FLIGHT=2

# Callback delivery
APP_CALLBACK__RETRY_COUNT=3
APP_CALLBACK__BASE_DELAY_SECONDS=2
APP_CALLBACK__TIMEOUT_SECONDS=10

# Input budget (characters); num_ctx must cover (CV + JD)/4 + 1500 + 2500 tokens
APP_INPUT__MAX_CV_CHARS=24000
APP_INPUT__MAX_JD_CHARS=8000
APP_INPUT__HARD_CEILING_CHARS=120000

# Optional: resolve relative resumeFileReference values against this folder
# APP_STORAGE__BASE_ROOT=C:\ats\storage

APP_SQLITE__PATH=./ats_fastapi.db

# Optional: require X-Dispatch-Token on POST /analyze
# APP_DISPATCH__TOKEN=

# ats_rubric_v2 also tells the model not to repeat list items or pad empty lists (ats-output-quality).
APP_PROMPT__TEMPLATE=ats_rubric_v1
APP_ORCHESTRATOR_DISPATCH_TIMEOUT_SECONDS=600

# Developer test harness (ats-debug-ui): synchronous, UNAUTHENTICATED per-stage inspection
# endpoints under /debug, plus a Streamlit UI. Leave false in any shared/production deployment.
APP_DEBUG__ENABLED=false
